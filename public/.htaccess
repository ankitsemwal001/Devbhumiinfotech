# ------------------------------------------------------------------------------
# Apache Configuration for Devbhoomi Infotech Solutions (Hostinger Shared / Apache)
# ------------------------------------------------------------------------------

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Force www. prefix for canonical hostname
  RewriteCond %{HTTP_HOST} ^devbhoomiinfotech\.com$ [NC]
  RewriteRule ^(.*)$ https://www.devbhoomiinfotech.com/$1 [R=301,L]

  # 3. Canonical 301 Redirects for pages not in old live sitemap
  RewriteRule ^ai-automation/?$ /services/ai-automation/ [R=301,L]
  RewriteRule ^digital-marketing/?$ /services/digital-marketing/ [R=301,L]

  # 4. Tag Next.js hashed static assets for immutable caching
  RewriteRule ^_next/static/ - [E=IMMUTABLE:1]

  # 5. Ensure trailing slash for directory routes (matches Next.js trailingSlash: true)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(.[a-zA-Z0-9]{1,5})$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://www.devbhoomiinfotech.com/$1/ [R=301,L]

  # 6. Serve index.html inside directory folders
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)/$ $1/index.html [L]
</IfModule>

# ------------------------------------------------------------------------------
# Custom 404 Error Document
# ------------------------------------------------------------------------------
ErrorDocument 404 /404.html

# ------------------------------------------------------------------------------
# Compression: mod_brotli and mod_deflate (html, css, js, json, svg, xml, txt)
# ------------------------------------------------------------------------------
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript application/json application/xml
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/opentype
  AddOutputFilterByType DEFLATE font/truetype
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
</IfModule>

# ------------------------------------------------------------------------------
# Cache-Control & Expiration Headers
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML documents: no-cache so new deploys show up immediately
  ExpiresByType text/html "access plus 0 seconds"

  # Images and fonts: 1 year
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ------------------------------------------------------------------------------
# Headers & Security Policies
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  # Hashed Next.js immutable assets caching
  Header set Cache-Control "public, max-age=31536000, immutable" env=IMMUTABLE

  # HTML Cache-Control: ensure deploys show up immediately
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # HTTP Strict Transport Security (HSTS)
  # Owner: Keep at max-age=300 initially (no includeSubDomains, no preload).
  # Raise to 31536000 only after verifying HTTPS everywhere across all assets for at least one week.
  Header always set Strict-Transport-Security "max-age=300"

  # Prevent MIME type sniffing
  Header always set X-Content-Type-Options "nosniff"

  # Referrer Policy
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Prevent Clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"

  # Permissions Policy
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
